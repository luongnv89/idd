{
  "default_version": "0.10.0",
  "placeholder_policy": {
    "change_rule": "Adding a placeholder requires updating this file and scripts/build.py substitution table.",
    "syntax": "dollar-brace variable names only"
  },
  "plugin": {
    "author": "${PLUGIN_AUTHOR}",
    "description": "${PLUGIN_DESCRIPTION}",
    "name": "${PLUGIN_NAME}",
    "slug": "${PLUGIN_SLUG}",
    "version": "${PLUGIN_VERSION}"
  },
  "values": {
    "PLUGIN_AUTHOR": "Luong NGUYEN <luongnv89@gmail.com>",
    "PLUGIN_DESCRIPTION": "Issue-Driven Development skills for GitHub issue creation, analysis, resolution, review, and triage.",
    "PLUGIN_NAME": "Issue-Driven Development",
    "PLUGIN_SLUG": "idd"
  }
}
