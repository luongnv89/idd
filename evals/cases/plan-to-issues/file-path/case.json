{
  "name": "plan-to-issues/file-path",
  "skill": "plan-to-issues",
  "prompt": "Turn docs/PLAN.md into GitHub issues with an epic on top that tracks the whole thing.",
  "repo_scripts": [
    "src/shared/scripts/gi-plan-map.py"
  ],
  "grade": [
    {
      "tool": "idd-lint",
      "args": ["issue", "OUT/epic-body-updated.md"],
      "expect_exit": 0,
      "label": "epic body written back with the plan map passes idd-lint"
    },
    {
      "tool": "idd-lint",
      "args": ["issue", "OUT/created-2.md"],
      "expect_exit": 0,
      "label": "child #2 body as filed passes idd-lint"
    },
    {
      "tool": "idd-lint",
      "args": ["issue", "OUT/created-3.md"],
      "expect_exit": 0,
      "label": "child #3 body as filed passes idd-lint"
    },
    {
      "tool": "idd-lint",
      "args": ["issue", "OUT/created-4.md"],
      "expect_exit": 0,
      "label": "child #4 body as filed passes idd-lint"
    },
    {
      "tool": "gh-calls",
      "expect_by_command": {
        "issue create": 4,
        "label create": 6,
        "api --method": 3,
        "api --paginate": 1
      },
      "expect_argv": [
        ["label", "list", "--limit", "200", "--json", "name", "--jq", ".[].name"],
        ["label", "create", "epic", "--description", "Tracking epic for a filed plan", "--color", "5319E7"],
        ["label", "create", "phase:p0", "--description", "Plan phase p0", "--color", "B60205"],
        ["label", "create", "dim:dep", "--description", "Audit dimension dep", "--color", "0E8A16"],
        ["label", "create", "priority:high", "--description", "Priority high", "--color", "D93F0B"],
        ["label", "create", "dim:ci", "--description", "Audit dimension ci", "--color", "0052CC"],
        ["label", "create", "phase:p1", "--description", "Plan phase p1", "--color", "D93F0B"],
        ["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"],
        ["api", "--paginate", "repos/eval/harness/issues?state=all&per_page=100", "--jq", ".[] | select(.pull_request == null) | {number,title,body,state,created_at,labels:[.labels[].name]}"],
        ["issue", "create", "--title", "Epic: Modernize acme-cli — P0–P1", "--body-file", "epic-create.md"],
        ["issue", "edit", "1", "--add-label", "epic"],
        ["issue", "view", "1", "--json", "body", "--jq", ".body"],
        ["issue", "edit", "1", "--body-file", "epic-body.md"],
        ["issue", "create", "--title", "0.1: Commit the lockfile", "--body-file", "child-0.1.md"],
        ["issue", "create", "--title", "0.2: Add the CI workflow", "--body-file", "child-0.2.md"],
        ["issue", "edit", "2", "--add-label", "phase:p0,improvement,dim:dep,priority:high"],
        ["api", "repos/eval/harness/issues/2", "--jq", ".id"],
        ["api", "--method", "POST", "repos/eval/harness/issues/1/sub_issues", "-F", "sub_issue_id=5000000002"],
        ["issue", "edit", "3", "--add-label", "phase:p0,improvement,dim:ci,priority:high"],
        ["api", "repos/eval/harness/issues/3", "--jq", ".id"],
        ["api", "--method", "POST", "repos/eval/harness/issues/1/sub_issues", "-F", "sub_issue_id=5000000003"],
        ["issue", "create", "--title", "1.1: Pin the Node runtime", "--body-file", "child-1.1.md"],
        ["issue", "edit", "4", "--add-label", "phase:p1,improvement,dim:dep,priority:high"],
        ["api", "repos/eval/harness/issues/4", "--jq", ".id"],
        ["api", "--method", "POST", "repos/eval/harness/issues/1/sub_issues", "-F", "sub_issue_id=5000000004"],
        ["issue", "edit", "1", "--body-file", "epic-body-updated.md"]
      ],
      "expect_exit": 0,
      "label": "labels created in one pass, epic created and bound before any child, one batch per phase, each child registered by database id"
    }
  ]
}
