{
  "name": "issue-creator/basic",
  "skill": "issue-creator",
  "prompt": "Create a bug issue for mobile login redirect loop",
  "grade": [
    {
      "tool": "idd-lint",
      "args": ["issue", "OUT/issue.md"],
      "expect_exit": 0,
      "label": "normalized issue body passes idd-lint"
    },
    {
      "tool": "shell",
      "args": ["python3 scripts/idd-lint.py branch \"$(tr -d '\\n' < OUT/branch.txt)\""],
      "expect_exit": 0,
      "label": "branch name from subject artifact passes idd-lint"
    },
    {
      "tool": "file-exists",
      "file": "OUT/issue-url.txt",
      "expect_exit": 0,
      "label": "gh issue create returned a URL"
    }
  ]
}
