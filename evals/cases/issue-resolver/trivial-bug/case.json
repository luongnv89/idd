{
  "name": "issue-resolver/trivial-bug",
  "skill": "issue-resolver",
  "prompt": "Fix the always-false login bug; prove red→green; open a conforming PR",
  "grade": [
    {
      "tool": "shell",
      "args": ["python3 scripts/idd-lint.py branch \"$(tr -d '\\n' < OUT/branch.txt)\""],
      "expect_exit": 0,
      "label": "branch name from subject artifact passes idd-lint"
    },
    {
      "tool": "shell",
      "args": ["python3 scripts/idd-lint.py commit \"$(tr -d '\\n' < OUT/commit.txt)\""],
      "expect_exit": 0,
      "label": "commit message from subject artifact passes idd-lint"
    },
    {
      "tool": "shell",
      "args": [
        "python3 scripts/idd-lint.py pr OUT/pr-body.md --title \"$(tr -d '\\n' < OUT/commit.txt)\""
      ],
      "expect_exit": 0,
      "label": "PR body passes idd-lint (Closes + DR + AC + Reproduction)"
    },
    {
      "tool": "gi-runlog-echo",
      "file": "OUT/run.json",
      "expect_exit": 0,
      "label": "runs.jsonl record validates via gi-runlog --echo"
    },
    {
      "tool": "file-exists",
      "file": "OUT/red-green.txt",
      "expect_exit": 0,
      "label": "red→green evidence file present"
    },
    {
      "tool": "shell",
      "args": ["grep -q 'red→green\\|red -> green\\|red->green' OUT/pr-body.md"],
      "expect_exit": 0,
      "label": "PR AC table or Reproduction mentions red→green"
    }
  ]
}
