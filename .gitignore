# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Environment
.env
.env.local
.env.*.local

# Node (if skills are installed via npx)
node_modules/
package-lock.json
yarn.lock

# Python (if test scripts use Python)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Test artifacts
tests/tmp/
tests/output/
*.log

# Claude Code local state
.claude/

# Build outputs not committed (per refactor-plan-v10 §1)
# - dist/skills/ and dist/agents/ are built by ./scripts/build.sh, not committed
dist/skills/
dist/agents/

# gstack browser/session artifacts
.gstack/

.asm-improver/

# Local review/analysis artifacts (session outputs, not project docs)
IDD-REVIEW-*.md
competitor-analysis-*.md
fable-5-review-*.md

# Autopilot/resolver run log (local activity, not committed)
.gitissue/runs.jsonl

# Per-issue analysis artifacts and the gi-issue TTL cache — both are local,
# regenerable, and can carry issue bodies that are not yet public
.gitissue/analysis-*.json
.gitissue/cache/

# /auto-pilot run state, run lock, and last-run report — machine-local, single-run,
# and regenerated on the next run (docs/config-schema.md → `.gitissue/` carve-out)
.gitissue/run.lock
.gitissue/run-state.json
.gitissue/last-run-report.md
