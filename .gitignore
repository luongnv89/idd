# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Environment
.env
.env.local
.env.*.local

# Node (if skills are installed via npx)
node_modules/
package-lock.json
yarn.lock

# Python (if test scripts use Python)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# Coverage artifacts (issue #333) — measured in CI, published as run artifacts
.coverage
.coverage.*
coverage-report/

# Promotion-lane private store (issue #517): held-out tasks, private rubrics,
# run transcripts and sealed keys never enter the repository
evals/promotion/private/

# Test artifacts
tests/tmp/
tests/output/
*.log

# Claude Code local state
.claude/

# Build outputs not committed (per refactor-plan-v10 §1)
# - dist skills, agents and catalog are built by ./scripts/build.sh
dist/skills/
dist/agents/
# Local-only flattened internal skills; never an install/release surface
/internal-skills/
dist/.agents/plugins/marketplace.json

# gstack browser/session artifacts
.gstack/

.asm-improver/

# Local review/analysis artifacts (session outputs, not project docs)
/local/

# Autopilot/resolver run log and its rotated segments (local activity, not committed)
.gitissue/runs.jsonl
.idd/runs.jsonl
.gitissue/runs-*.jsonl
.idd/runs-*.jsonl

# Correction-guard proposal ledger (local scratch; docs/correction-guards.md)
.gitissue/improvement-proposals.jsonl
.idd/improvement-proposals.jsonl

# Analysis, triage, and issue-cache artifacts are local and regenerable; they
# can carry issue bodies and repository findings that should not be committed.
.gitissue/analysis-*.json
.idd/analysis-*.json
.gitissue/triage.json
.idd/triage.json
.gitissue/cache/
.idd/cache/

# /auto-pilot run state, run lock, and last-run report — machine-local, single-run,
# and regenerated on the next run (docs/config-schema.md → `.idd/` carve-out).
# Each `.idd/` line is mirrored by its legacy `.gitissue/` line (issue #537):
# installed pre-rename skills still write the legacy directory.
.gitissue/run.lock
.idd/run.lock
.gitissue/run-state.json
.idd/run-state.json
.gitissue/last-run-report.md
.idd/last-run-report.md
